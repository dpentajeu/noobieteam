# Noobieteam Environment Configuration Template
#
# Copy to `.env` and fill in real values:   cp .env.template .env
# `.env` is gitignored. Never commit real keys.
#
# Every variable below is optional unless marked REQUIRED — the app boots with
# defaults, but Google sign-in and the AI assistant stay disabled until their
# keys are set.


# ─── Auth ─────────────────────────────────────────────────────────────────────

# REQUIRED in production. Signing key for session JWTs.
# In development a fixed insecure fallback is used and the server logs a warning.
# Generate one:   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_secure_random_string

# Session lifetime, in the `ms` / jsonwebtoken format (e.g. 7d, 12h, 30m).
# Default: 7d
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 client ID, from Google Cloud Console -> APIs & Services ->
# Credentials. Without it, "Sign in with Google" returns an error.
# Only the client ID is used: the browser gets an ID token from Google and the
# server verifies it, so there is no authorization-code exchange and therefore
# no client secret in this flow.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com


# ─── Admin & RBAC ─────────────────────────────────────────────────────────────

# The user with this exact email becomes Super Admin: sees every workspace
# without an invitation and can delete workspaces.
# Default: admin@noobieteam.ai
ADMIN_EMAIL=YOUR_ADMIN_EMAIL@example.com


# ─── Database ─────────────────────────────────────────────────────────────────

# MongoDB connection string.
# Default: mongodb://localhost:27017/noobieteam
# If the connection fails, the server falls back to an in-memory MongoDB so it
# still boots — data written there does not survive a restart.
MONGODB_URI=mongodb://localhost:27017/noobieteam

# Set to "true" to skip MongoDB entirely (no connection, no fallback).
# For tests and UI-only work. Default: unset
# MOCK_DB=true


# ─── AI Assistant ─────────────────────────────────────────────────────────────
#
# One OpenAI-compatible endpoint. The GEMINI_* variables win when set; the
# OPENAI_* ones are the fallback for each field. Any provider speaking the
# OpenAI chat-completions API works — point the *_BASE_URL at it.
# With no key set, the AI features report themselves as unconfigured.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_ID=gemini-3-flash-preview

# Used only for whichever of the three fields above is unset.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4o-mini


# ─── Uploads ──────────────────────────────────────────────────────────────────
#
# Uploaded media is stored on this server's disk in <repo>/uploads/<category>/
# and served at /media/. There is no cloud storage and nothing to configure —
# the path is not settable by env var. Back up `uploads/` with the database.

# Per-file upload size cap, in bytes. Default: 26214400 (25 MB)
MAX_UPLOAD_BYTES=26214400


# ─── API-testing proxy ────────────────────────────────────────────────────────
#
# SECURITY: the proxy fetches URLs users type, so any host allowed here is
# reachable by every workspace member. Empty by default, which blocks all
# private, loopback and reserved addresses (SSRF guard).
#
# Set this only to test a service on your own machine, and only where you
# control everyone who can reach the app. Leave empty on any shared or
# internet-facing deployment.
#
# Comma-separated `host` or `host:port`. A bare host allows every port on it.
#   PROXY_ALLOWED_HOSTS=localhost:3000
#   PROXY_ALLOWED_HOSTS=localhost,127.0.0.1,api.internal:8080
PROXY_ALLOWED_HOSTS=
